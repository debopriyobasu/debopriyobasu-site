---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { useTranslations, ui } from "../../../i18n/ui";
import { getRelativeLocaleUrl } from "astro:i18n";
import { SITE_CONFIG } from "../../../config";
import Pagination from "../../../components/Pagination.astro";

export async function getStaticPaths() {
  const nonDefaultLocales = Object.keys(ui).filter((lang) => lang !== "en");
  return nonDefaultLocales.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const allPosts = await getCollection("blog", ({ data }) => !data.draft);

// Helper function to extract slug and lang from post.id
function parsePostId(id: string) {
  const lastSlash = id.lastIndexOf("/");
  if (lastSlash === -1) {
    return { slug: id, postLang: "en" };
  }
  return {
    slug: id.slice(0, lastSlash),
    postLang: id.slice(lastSlash + 1),
  };
}

// Find all unique slugs
const uniqueSlugs = [...new Set(allPosts.map((post) => parsePostId(post.id).slug))];

// Resolve posts for this locale with fallback to English
const posts = uniqueSlugs
  .map((slug) => {
    // 1. Try to find translation for current lang
    const localizedPost = allPosts.find((p) => {
      const parsed = parsePostId(p.id);
      return parsed.slug === slug && parsed.postLang === lang;
    });
    if (localizedPost) {
      return { post: localizedPost, isFallback: false };
    }
    // 2. Fallback to English
    const englishPost = allPosts.find((p) => {
      const parsed = parsePostId(p.id);
      return parsed.slug === slug && parsed.postLang === "en";
    });
    if (englishPost) {
      return { post: englishPost, isFallback: true };
    }
    return null;
  })
  .filter((item): item is { post: any; isFallback: boolean } => item !== null)
  .sort((a, b) => b.post.data.date.valueOf() - a.post.data.date.valueOf());

const allTags = [...new Set(posts.flatMap((item) => item.post.data.tags || []))].sort();

const t = useTranslations(lang as any);
const homeUrl = getRelativeLocaleUrl(lang as any, "");
const postsPerPage = SITE_CONFIG.postsPerPage;
---

<BaseLayout
  title={t("blog.title")}
  description={t("blog.subtitle")}
>
  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <ol>
      <li><a href={homeUrl}>{t("nav.home")}</a></li>
      <li aria-hidden="true" class="breadcrumb-sep">›</li>
      <li aria-current="page">{t("nav.blog")}</li>
    </ol>
  </nav>

  <h2 class="blog-index-title">{t("blog.title")}</h2>
  <p class="blog-index-subtitle">{t("blog.subtitle")}</p>

  {
    allTags.length > 0 && (
      <div class="tags-filter-section">
        <button id="filter-toggle" class="filter-toggle-btn" aria-expanded="false">
          <svg class="filter-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
          <span>{t("blog.filter_by_tag")}</span>
          <svg class="chevron-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        
        <div id="filter-collapse" class="filter-collapse-content hidden">
          <div class="tags-search-wrapper">
            <input type="text" id="tag-search" placeholder={t("blog.search_tags")} class="tag-search-input" />
          </div>
          <ul class="all-tags-list">
            <li class="filter-tag-item active" data-tag="all">
              <button class="tag-filter-btn">{t("blog.all_tags")}</button>
            </li>
            {allTags.map((tag) => (
              <li class="filter-tag-item" data-tag={tag}>
                <button class="tag-filter-btn">{tag}</button>
              </li>
            ))}
          </ul>
        </div>
      </div>
    )
  }

  <ul class="blog-post-list">
    {
      posts.map(({ post, isFallback }) => {
        const { slug } = parsePostId(post.id);
        const postUrl = getRelativeLocaleUrl(lang as any, `blog/${slug}`);
        const tagString = post.data.tags ? post.data.tags.join(",") : "";
        return (
          <li class="blog-post-item" data-tags={tagString}>
            <a href={postUrl} class="blog-post-link-row">
              <span class="blog-post-item-title">
                {post.data.title}
                {isFallback && <span class="fallback-badge" style="font-size: 0.75rem; font-weight: normal; color: var(--muted); margin-left: 0.5rem; border: 1px solid var(--border); padding: 0.1rem 0.3rem; border-radius: 4px;">EN</span>}
              </span>
              <span class="blog-post-item-date">
                {post.data.date.toLocaleDateString(lang, {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </span>
            </a>
            {post.data.tags && post.data.tags.length > 0 && (
              <ul class="tags-list">
                {post.data.tags.map((tag) => (
                  <li class="tag-item">
                    <a href={getRelativeLocaleUrl(lang as any, "blog") + `?tag=${tag}`}>{tag}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        );
      })
    }
  </ul>

  <Pagination
    postsPerPage={postsPerPage}
    prevText={t("blog.pagination.prev")}
    nextText={t("blog.pagination.next")}
    pageText={t("blog.pagination.page")}
  />

  <footer class="blog-post-footer">
    <a href={homeUrl} class="back-link">{t("blog.back")}</a>
  </footer>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const toggleBtn = document.getElementById('filter-toggle');
      const collapseContent = document.getElementById('filter-collapse');
      const tagSearch = document.getElementById('tag-search');
      const tagItems = document.querySelectorAll('.filter-tag-item');
      const postItems = Array.from(document.querySelectorAll('.blog-post-item'));
      const paginationContainer = document.getElementById('pagination-controls');

      if (!paginationContainer) return;

      const postsPerPage = parseInt(paginationContainer.getAttribute('data-posts-per-page') || '10', 10);
      let currentTag = 'all';
      let currentPage = 1;

      // 1. Toggle filter collapse
      toggleBtn?.addEventListener('click', () => {
        const expanded = toggleBtn.getAttribute('aria-expanded') === 'true';
        toggleBtn.setAttribute('aria-expanded', String(!expanded));
        collapseContent?.classList.toggle('hidden');
      });

      // Filter and paginate main logic
      function updateBlogList() {
        // Filter posts matching currentTag
        const matchingPosts = postItems.filter(post => {
          if (currentTag === 'all') return true;
          const postTagsStr = post.getAttribute('data-tags') || '';
          const postTags = postTagsStr.split(',').map(t => t.trim()).filter(Boolean);
          return postTags.includes(currentTag);
        });

        const totalPosts = matchingPosts.length;
        const totalPages = Math.ceil(totalPosts / postsPerPage);

        // Adjust currentPage if it goes out of bounds
        if (currentPage > totalPages) {
          currentPage = Math.max(1, totalPages);
        }

        // Hide all posts by default
        postItems.forEach(post => {
          post.style.display = 'none';
        });

        // Show posts for current page
        const startIdx = (currentPage - 1) * postsPerPage;
        const endIdx = startIdx + postsPerPage;
        const pagePosts = matchingPosts.slice(startIdx, endIdx);
        pagePosts.forEach(post => {
          post.style.display = '';
        });

        renderPagination(totalPages);
      }

      // Render pagination buttons dynamically
      function renderPagination(totalPages) {
        if (totalPages <= 1) {
          paginationContainer.innerHTML = '';
          paginationContainer.style.display = 'none';
          return;
        }

        paginationContainer.style.display = 'flex';
        let html = '';

        // Previous button
        const prevDisabled = currentPage === 1 ? 'disabled' : '';
        const prevText = paginationContainer.getAttribute('data-prev-text') || '← Previous';
        html += `<button class="pagination-btn" data-page="${currentPage - 1}" ${prevDisabled} aria-label="${prevText}">${prevText}</button>`;

        // Numbered pages (with ellipsis truncation if many pages)
        const pagesToShow = [];
        const range = 1; // pages to show around current page

        for (let i = 1; i <= totalPages; i++) {
          if (i === 1 || i === totalPages || (i >= currentPage - range && i <= currentPage + range)) {
            pagesToShow.push(i);
          } else if ((i === currentPage - range - 1 && i > 1) || (i === currentPage + range + 1 && i < totalPages)) {
            pagesToShow.push('...');
          }
        }

        let lastVal = null;
        pagesToShow.forEach(p => {
          if (p === '...') {
            if (lastVal !== '...') {
              html += `<span class="pagination-ellipsis" aria-hidden="true">...</span>`;
            }
          } else {
            const activeClass = p === currentPage ? 'active' : '';
            const pageText = paginationContainer.getAttribute('data-page-text') || 'Page {page}';
            const ariaLabel = pageText.replace('{page}', String(p));
            const ariaCurrent = p === currentPage ? 'aria-current="page"' : '';
            html += `<button class="pagination-btn ${activeClass}" data-page="${p}" ${ariaCurrent} aria-label="${ariaLabel}">${p}</button>`;
          }
          lastVal = p;
        });

        // Next button
        const nextDisabled = currentPage === totalPages ? 'disabled' : '';
        const nextText = paginationContainer.getAttribute('data-next-text') || 'Next →';
        html += `<button class="pagination-btn" data-page="${currentPage + 1}" ${nextDisabled} aria-label="${nextText}">${nextText}</button>`;

        paginationContainer.innerHTML = html;

        // Add click events to buttons
        paginationContainer.querySelectorAll('button[data-page]').forEach(button => {
          button.addEventListener('click', () => {
            const targetPage = parseInt(button.getAttribute('data-page') || '1', 10);
            if (targetPage >= 1 && targetPage <= totalPages && targetPage !== currentPage) {
              currentPage = targetPage;

              const url = new URL(window.location.href);
              url.searchParams.set('page', String(currentPage));
              window.history.pushState({}, '', url.toString());

              updateBlogList();

              const blogList = document.querySelector('.blog-post-list');
              if (blogList) {
                blogList.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }
            }
          });
        });
      }

      // Update active tag button class in filters panel
      function updateTagUI() {
        tagItems.forEach(item => {
          if (item.getAttribute('data-tag') === currentTag) {
            item.classList.add('active');
          } else {
            item.classList.remove('active');
          }
        });
      }

      // 2. Click tag handler
      tagItems.forEach(item => {
        item.addEventListener('click', () => {
          const tag = item.getAttribute('data-tag') || 'all';
          currentTag = tag;
          currentPage = 1;

          const url = new URL(window.location.href);
          if (tag === 'all') {
            url.searchParams.delete('tag');
          } else {
            url.searchParams.set('tag', tag);
          }
          url.searchParams.delete('page');
          window.history.pushState({}, '', url.toString());

          updateTagUI();
          updateBlogList();
        });
      });

      // 3. Search tags
      tagSearch?.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase();
        tagItems.forEach(item => {
          const tag = (item.getAttribute('data-tag') || '').toLowerCase();
          if (tag === 'all') return;
          
          if (tag.includes(query)) {
            item.style.display = '';
          } else {
            item.style.display = 'none';
          }
        });
      });

      // 4. Initial filter check on load
      const params = new URLSearchParams(window.location.search);
      const initialTag = params.get('tag');
      if (initialTag) {
        currentTag = initialTag;
        toggleBtn?.setAttribute('aria-expanded', 'true');
        collapseContent?.classList.remove('hidden');
      }

      const initialPage = parseInt(params.get('page') || '1', 10);
      if (initialPage > 0) {
        currentPage = initialPage;
      }

      // 5. Browser history popstate handler
      window.addEventListener('popstate', () => {
        const stateParams = new URLSearchParams(window.location.search);
        currentTag = stateParams.get('tag') || 'all';
        currentPage = parseInt(stateParams.get('page') || '1', 10);
        updateTagUI();
        updateBlogList();
      });

      updateTagUI();
      updateBlogList();
    });
  </script>
</BaseLayout>
