---
import { getCollection } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { useTranslations } from "../../../../i18n/ui";
import { getRelativeLocaleUrl } from "astro:i18n";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog", ({ data }) => !data.draft);
  const posts = allPosts.filter((post) => post.id.startsWith("hi/"));
  const tags = [...new Set(posts.flatMap((post) => post.data.tags || []))];
  
  return tags.map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((post) => post.data.tags?.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;

const t = useTranslations("hi");
const homeUrl = getRelativeLocaleUrl("hi", "");
const blogUrl = getRelativeLocaleUrl("hi", "blog");

const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title={`${t("blog.tagged_with")} "${tag}"`}
  description={`${t("blog.tagged_with")} "${tag}"`}
>
  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <ol>
      <li><a href={homeUrl}>{t("nav.home")}</a></li>
      <li aria-hidden="true" class="breadcrumb-sep">›</li>
      <li><a href={blogUrl}>{t("nav.blog")}</a></li>
      <li aria-hidden="true" class="breadcrumb-sep">›</li>
      <li aria-current="page">{t("blog.tags")}: {tag}</li>
    </ol>
  </nav>

  <h2 class="blog-index-title">{t("blog.tagged_with")} "{tag}"</h2>
  
  <ul class="blog-post-list">
    {
      sortedPosts.map((post) => {
        const cleanSlug = post.id.replace(/^hi\//, "");
        const postUrl = getRelativeLocaleUrl("hi", `blog/${cleanSlug}`);
        return (
          <li class="blog-post-item">
            <a href={postUrl} class="blog-post-link-row">
              <span class="blog-post-item-title">{post.data.title}</span>
              <span class="blog-post-item-date">
                {post.data.date.toLocaleDateString("hi", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </span>
            </a>
            {post.data.tags && post.data.tags.length > 0 && (
              <ul class="tags-list">
                {post.data.tags.map((tVal) => (
                  <li class="tag-item">
                    <a href={getRelativeLocaleUrl("hi", "blog") + `?tag=${tVal}`}>{tVal}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        );
      })
    }
  </ul>

  <footer class="blog-post-footer">
    <a href={blogUrl} class="back-link">{t("blog.back_to_blog")}</a>
  </footer>
</BaseLayout>
