---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { useTranslations } from "../../../i18n/ui";
import { getRelativeLocaleUrl } from "astro:i18n";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const posts = allPosts
  .filter((post) => post.id.startsWith("bn/"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const t = useTranslations("bn");
const homeUrl = getRelativeLocaleUrl("bn", "");
---

<BaseLayout
  title={t("blog.title")}
  description={t("blog.subtitle")}
>
  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <ol>
      <li><a href={homeUrl}>{t("nav.home")}</a></li>
      <li aria-hidden="true" class="breadcrumb-sep">›</li>
      <li aria-current="page">{t("nav.blog")}</li>
    </ol>
  </nav>

  <h2 class="blog-index-title">{t("blog.title")}</h2>
  <p class="blog-index-subtitle">{t("blog.subtitle")}</p>

  <ul class="blog-post-list">
    {
      posts.map((post) => {
        const cleanSlug = post.id.replace(/^bn\//, "");
        const postUrl = getRelativeLocaleUrl("bn", `blog/${cleanSlug}`);
        return (
          <li class="blog-post-item">
            <a href={postUrl} class="blog-post-link">
              <span class="blog-post-item-title">{post.data.title}</span>
              <span class="blog-post-item-date">
                {post.data.date.toLocaleDateString("bn", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>

  <footer class="blog-post-footer">
    <a href={homeUrl} class="back-link">{t("blog.back")}</a>
  </footer>
</BaseLayout>
